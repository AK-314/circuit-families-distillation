{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage13-decision-dossier/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created_date",
    "implementation_base",
    "authority_owner",
    "scientific_data",
    "production_eligible",
    "definitive_execution_started",
    "evidence_firewall",
    "approval",
    "recommended_package_id",
    "decisions",
    "deferred_decisions",
    "package_alternatives"
  ],
  "properties": {
    "schema_version": {"const": "stage13-decision-dossier/v1"},
    "status": {"enum": ["recommended_package_pending_alex_approval", "approved"]},
    "created_date": {"type": "string", "format": "date"},
    "implementation_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_owner": {"const": "Alex"},
    "scientific_data": {"const": false},
    "production_eligible": {"const": false},
    "definitive_execution_started": {"const": false},
    "evidence_firewall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted_evidence_used", "excluded_evidence", "registered_or_private_artifacts_accessed"],
      "properties": {
        "permitted_evidence_used": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "excluded_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "registered_or_private_artifacts_accessed": {"const": false}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_approver", "approved_package_id", "approval_date", "approval_text", "dossier_sha256"],
      "properties": {
        "status": {"enum": ["pending", "approved"]},
        "required_approver": {"const": "Alex"},
        "approved_package_id": {"type": ["string", "null"]},
        "approval_date": {"type": ["string", "null"]},
        "approval_text": {"type": ["string", "null"]},
        "dossier_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
      }
    },
    "recommended_package_id": {"const": "stage13-package-a-conservative-protected/v1"},
    "decisions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "question", "downstream_consequences", "stage11_direction", "stage12_evidence", "viable_options", "invalid_options", "protected_tier_consequences", "recommendation", "rationale", "uncertainty", "amendment_consequence", "requires_alex_choice"],
        "properties": {
          "decision_id": {"pattern": "^RD-0(0[1-9]|1[0-24])$"},
          "question": {"type": "string", "minLength": 1},
          "downstream_consequences": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "stage11_direction": {"type": "string", "minLength": 1},
          "stage12_evidence": {"type": "string", "minLength": 1},
          "viable_options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["option", "description", "tradeoff"],
              "properties": {"option": {"type": "string"}, "description": {"type": "string"}, "tradeoff": {"type": "string"}}
            }
          },
          "invalid_options": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "protected_tier_consequences": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier1", "tier2", "tier3"],
            "properties": {"tier1": {"type": "string"}, "tier2": {"type": "string"}, "tier3": {"type": "string"}}
          },
          "recommendation": {"type": "object", "minProperties": 2},
          "rationale": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "amendment_consequence": {"type": "string", "minLength": 1},
          "requires_alex_choice": {"const": true}
        }
      }
    },
    "deferred_decisions": {
      "type": "array",
      "prefixItems": [{
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "status", "reason"],
        "properties": {"decision_id": {"const": "RD-013"}, "status": {"const": "pending_stage14"}, "reason": {"type": "string"}}
      }],
      "minItems": 1,
      "maxItems": 1
    },
    "package_alternatives": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "summary"],
        "properties": {"package_id": {"type": "string"}, "summary": {"type": "string"}}
      }
    }
  }
}
