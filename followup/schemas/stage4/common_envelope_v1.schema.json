          "type": "string"
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "record_type": {
          "enum": [
            "teacher_reference",
            "teacher_output_cache",
            "student_attempt",
            "student_eligibility",
            "sealed_dense_model",
            "discovery_run",
            "native_budget_ledger",
            "exact_mask_evaluation_ledger",
            "endpoint_record",
            "student_cell_summary",
            "teacher_seed_inventory",
            "excluded_development_output",
            "reproduction_comparison",
            "analysis_freeze"
