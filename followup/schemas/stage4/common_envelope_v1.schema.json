        },
        "schema_version": {
          "enum": [
            "analysis_freeze/v1",
            "discovery_run/v1",
            "endpoint_record/v1",
            "exact_mask_evaluation_ledger/v1",
            "excluded_development_output/v1",
            "native_budget_ledger/v1",
            "reproduction_comparison/v1",
            "sealed_dense_model/v1",
            "student_attempt/v1",
            "student_cell_summary/v1",
            "student_eligibility/v1",
            "teacher_output_cache/v1",
            "teacher_reference/v1",
            "teacher_seed_inventory/v1"
          ]
        }
      },
      "required": [
        "record_type",
        "schema_version",
        "condition_id"
      ],
      "type": "object"
    },
    "seed_evidence": {
      "additionalProperties": false,
      "properties": {
        "digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "seed_derivation_version": {
          "const": "seed-derivation/v1"
        },
        "seed_material": {
          "minLength": 1,
          "type": "string"
        },
        "seed_value": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "selected_bytes_hex": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        }
      },
      "required": [
        "seed_derivation_version",
        "seed_material",
        "digest_sha256",
        "selected_bytes_hex",
        "seed_value"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "version_reference": {
      "pattern": "^[a-z][a-z0-9._-]*/v[1-9][0-9]*$",
      "type": "string"
    }
  },
