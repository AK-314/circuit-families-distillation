{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:circuit-families-distillation:schema:stage5bc-technical-profile:v1",
  "title": "Stage 5B/C technical-only injected profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_kind",
    "classification",
    "scientific_data",
    "production_eligible",
    "settings_status",
    "decision_dependencies",
    "resolves_decisions",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": "stage5bc-technical-profile/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^technical-[a-z0-9-]+/v[1-9][0-9]*$"
    },
    "profile_kind": {
      "enum": [
        "architecture",
        "trainer",
        "adapter",
        "resume",
        "orchestration"
      ]
    },
    "classification": {
      "const": "technical_fixture"
    },
    "scientific_data": {
      "const": false
    },
    "production_eligible": {
      "const": false
    },
    "settings_status": {
      "const": "technical_candidate_only"
    },
    "decision_dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UD-003",
          "UD-004",
          "UD-005",
          "UD-006",
          "UD-013"
        ]
      }
    },
    "resolves_decisions": {
      "type": "array",
      "maxItems": 0
    },
    "settings": {
      "type": "object"
    }
  }
}
