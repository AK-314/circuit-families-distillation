{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "circuit-families-distillation/predecessor-link/v1",
  "title": "Circuit Families Distillation Predecessor Link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace_version",
    "predecessor",
    "successor_snapshot",
    "dataset",
    "architecture",
    "component_basis",
    "teacher_runs",
    "stage3_checkpoint_registry",
    "prior_results_visibility",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "namespace_version": {
      "const": "circuit-families-distillation/v1"
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "analysis_freeze_commit",
        "protocol",
        "implementation_order",
        "analysis_freeze_manifest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "analysis_freeze_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "protocol": {
          "$ref": "#/$defs/pathHash"
        },
        "implementation_order": {
          "$ref": "#/$defs/pathHash"
        },
        "analysis_freeze_manifest": {
          "$ref": "#/$defs/pathHash"
        }
      }
    },
    "successor_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "initial_commit",
        "relationship",
        "overlapping_file_count",
        "byte_identical_overlapping_file_count",
        "changed_overlapping_file_count"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "initial_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "relationship": {
          "const": "clean_source_snapshot_without_predecessor_scientific_outputs"
        },
        "overlapping_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "byte_identical_overlapping_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_overlapping_file_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "run_id",
        "dataset_sha256",
        "split_sha256",
        "archive_sha256",
        "metadata_sha256",
        "task_config"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/pathHash"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "split_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "task_config": {
          "$ref": "#/$defs/configIdentity"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_config",
        "training_config",
        "transformer_source"
      ],
      "properties": {
        "model_config": {
          "$ref": "#/$defs/configIdentity"
        },
        "training_config": {
          "$ref": "#/$defs/configIdentity"
        },
        "transformer_source": {
          "$ref": "#/$defs/pathHash"
        }
      }
    },
    "component_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stage8_masking_manifest",
        "masks_source",
        "component_ablation_source",
        "dedicated_component_basis_sha256"
      ],
      "properties": {
        "status": {
          "const": "reused_predecessor_definition"
        },
        "stage8_masking_manifest": {
          "$ref": "#/$defs/pathHash"
        },
        "masks_source": {
          "$ref": "#/$defs/pathHash"
        },
        "component_ablation_source": {
          "$ref": "#/$defs/pathHash"
        },
        "dedicated_component_basis_sha256": {
          "type": "null"
        }
      }
    },
    "teacher_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "teacher_seed",
          "run_id",
          "manifest"
        ],
        "properties": {
          "teacher_seed": {
            "type": "integer",
            "minimum": 0
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "$ref": "#/$defs/pathHash"
          }
        }
      }
    },
    "stage3_checkpoint_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "resolved",
        "selection_records",
        "deferred_fields"
      ],
      "properties": {
        "status": {
          "const": "deferred_to_stage_3"
        },
        "resolved": {
          "const": false
        },
        "selection_records": {
          "type": "array",
          "maxItems": 0
        },
        "deferred_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prior_results_visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_primary_analysis_visible",
        "predecessor_analysis_freeze_complete",
        "followup_distillation_endpoints_produced",
        "followup_predictive_fidelity_endpoints_produced",
        "predecessor_results_are_blinded_pilot_evidence"
      ],
      "properties": {
        "predecessor_primary_analysis_visible": {
          "const": true
        },
        "predecessor_analysis_freeze_complete": {
          "const": true
        },
        "followup_distillation_endpoints_produced": {
          "const": false
        },
        "followup_predictive_fidelity_endpoints_produced": {
          "const": false
        },
        "predecessor_results_are_blinded_pilot_evidence": {
          "const": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "stage",
        "scientific_execution"
      ],
      "properties": {
        "record_type": {
          "const": "predecessor_link"
        },
        "stage": {
          "const": 1
        },
        "scientific_execution": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "configIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "file_sha256",
        "mapping_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mapping_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
